{
  "name": "movue",
  "productName": "Movue",
  "version": "0.16.0",
  "description": "Die Mediatheken von ARD, ZDF, 3sat und Arte in einer Desktop-App für Linux Mint",
  "homepage": "https://github.com/morogge/movue-linuxmint",
  "author": "morogge",
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:help": "node scripts/check-help.mjs",
    "dist": "electron-vite build && electron-builder --linux deb AppImage --publish never"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@playwright/test": "^1.54.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "hls.js": "^1.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "de.morogge.movue",
    "productName": "Movue",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "category": "AudioVideo",
      "icon": "build/icon.png",
      "maintainer": "morogge <morogge@users.noreply.github.com>",
      "synopsis": "Mediatheken von ARD, ZDF, 3sat und Arte in einer App",
      "executableName": "movue"
    },
    "deb": {
      "packageCategory": "video"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "morogge",
        "repo": "movue-linuxmint"
      }
    ]
  }
}
